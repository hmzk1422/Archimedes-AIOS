      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nconst params = item.params || {};\nconst body = item.body || item;\n\nconst platform = String(params.platform || body.platform || 'unknown').trim().toLowerCase();\nconst token = String(params.token || body.token || '').trim();\nlet message = body.message || body;\nlet customer_id = body.customer_id || '';\n\nif (platform === 'telegram') {\n  message = body.message || body.edited_message || body;\n  customer_id = customer_id || message?.chat?.id || message?.from?.id || '';\n}\n\nif (platform === 'whatsapp') {\n  const value = body.entry?.[0]?.changes?.[0]?.value;\n  const waMessage = value?.messages?.[0];\n  message = waMessage || body;\n  customer_id = customer_id || waMessage?.from || value?.contacts?.[0]?.wa_id || '';\n}\n\nif (platform === 'zendesk') {\n  message = body;\n  customer_id = customer_id || body.ticket_id || body.ticket?.id || body.requester?.id || '';\n}\n\nreturn {\n  platform,\n  token,\n  message,\n  customer_id: String(customer_id || ''),\n};"
      },
