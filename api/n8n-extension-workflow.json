    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nconst outbound = item.outbound || {};\nconst email = outbound.zendesk_email;\nconst token = outbound.zendesk_token;\n\nif (!email || !token) {\n  throw new Error('Missing zendesk_email or zendesk_token in Python API outbound config.');\n}\n\nreturn {\n  ...item,\n  zendesk_auth_header: `Basic ${Buffer.from(`${email}/token:${token}`).toString('base64')}`,\n};"
      },
